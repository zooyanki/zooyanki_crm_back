# Скопируй в .env и заполни. Файл .env в git не попадает.

NODE_ENV=development
PORT=3000

# Совпадает с docker-compose.yml
DATABASE_URL=postgresql://zooyanki:zooyanki@localhost:5432/zooyanki_crm?schema=public
REDIS_URL=redis://localhost:6379

# Ключ шифрования секретов площадок: 32 байта в hex (64 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Базовый URL API Авито, менять не требуется
AVITO_API_BASE_URL=https://api.avito.ru

# Публичный адрес сервиса. Нужен для вебхука мессенджера и XML-фида
# автозагрузки (фазы 4 и 5). На старте можно оставить пустым.
PUBLIC_BASE_URL=
